            Variable      "OutputFcn"
            Value         "X_aP = 0.50 * (2 *X_alS + X_alD + 2*X_0S + X_0D);\n"
"X_bP = 0.25 * (-2 *X_alS - X_alD + 3.464102 *X_beS + 1.732051 *X_beD + 4 *X_0"
"S + 2 *X_0D);\nX_cP = 0.25 * (-2 *X_alS - X_alD - 3.464102 *X_beS - 1.732051 "
"*X_beD + 4 *X_0S + 2 *X_0D);\nX_aN = 0.50 * (2 *X_alS - X_alD + 2*X_0S - X_0D"
");\nX_bN = 0.25 * (- 2 *X_alS + X_alD + 3.464102 *X_beS - 1.732051 *X_beD + 4"
" *X_0S - 2 *X_0D);\nX_cN = 0.25 * (- 2 *X_alS + X_alD - 3.464102 *X_beS + 1.7"
"32051 *X_beD + 4 *X_0S - 2 *X_0D);"
            Show          off
          }
