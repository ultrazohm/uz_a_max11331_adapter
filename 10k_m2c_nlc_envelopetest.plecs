"n\");\n\nprintf(\"Vref:%f\\n\",Vref);\nif(S>0)printf(\"Signo corriente:Positi"
"vo\\n\");\nelse printf(\"Signo corriente:Negativo\\n\");\nprintf(\"level:%d\\"
"n\",level-nc);\nprintf(\"rr:%d\\n\",rr);\n\nprintf(\"vprom:%f\\n\",vprom);\n"
"\nfor(i=0;i<2*nc+1;i++){\n\tfor(j=0;j<nc;j++){\n\t\t\tprintf(\"%d \",tabla[i]"
"[j]);\n\t\t\t}\n  \t printf(\"\\n\");\n\n}\nprintf(\"Funcion de disparo \\n\""
