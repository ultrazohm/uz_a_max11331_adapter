"clude <stdio.h>\n\n#define error       Input(0)\n#define FF       Input(1)\n"
"\n#define Out        Output(0)\n\n\n\n#define h         ParamRealData(0,0)  /"
"/sample period\n#define kp         ParamRealData(1,0)  //sample period\n#defi"
"ne ki         ParamRealData(2,0)  //sample period\n#define umax         Param"
"RealData(3,0)  //sample period\n\n\n#define max(x, y)\t(x) > (y) ? (x) : (y)"
"\n#define min(x, y)\t(x) < (y) ? (x) : (y)\n#define PI\t\t\t3.141592653589793"
"23846\n\nfloat FF1;\nfloat out_1 =0.0;\nfloat x = 0.0;\nfloat e_1=0.0;\nfloat"
" umin,out_temp;\nfloat a1,a0;\nfloat b0,b1;\n"
                    Show          off
                  }
                  Parameter {
                    Variable      "StartFcn"
                    Value         "\na1=1.0;\nb0=kp+ki*h/2;\nb1=-kp+ki*h/2;\n"
"\numin=-1.0*umax;"
                    Show          off
                  }
                  Parameter {
                    Variable      "OutputFcn"
                    Value         "// Implementation of PR discrete with tusti"
"n with prewarping\n\nout_temp=out_1*a1+error*b0+e_1*b1;\nFF1=FF;\n//if(FF>uma"
"x)FF1=umax;\n//if(FF<umin)FF1=umin;\n\nif((out_temp)>(umax-FF1)){\nout_temp=u"
"max-FF1;\n}\nelse if((out_temp)<(umin-FF1)){\n\tout_temp=umin-FF1;\n\t}\nelse"
"{\n\te_1=error;\n\t}\nout_1=out_temp;\nOut=out_temp;"
                    Show          off
                  }
