"ct voltages{\n\tfloat volt;\n\tint pos;\n\n};\n\nstruct voltages Vxyvector[6]"
";\n\n\nfloat x = 0.0;\n//float Vxyvector[6];\nint level;\nfloat vprom;\nint r"
"r;\nstruct voltages swap;\nfloat e_1=0.0;\nfloat place[6];\nfloat umin,out_te"
"mp;\nfloat a1,a0;\nfloat b0,b1;\nint i,j;\nint c,nc;\nint orden[6];\nint SWte"
"mp[6];\nint counter=0;"
                    Show          off
