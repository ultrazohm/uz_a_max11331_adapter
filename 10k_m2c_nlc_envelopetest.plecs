                Variable      "OutputFcn"
                Value         "// Implementation of PR discrete with tustin wi"
"th prewarping\n\n\nOut=-out_1*a1/a0-out_2*a2/a0+In*b0/a0+e_1*b1/a0+e_2*b2/a0;"
"\n\nout_2=out_1;\nout_1=Out;\ne_2=e_1;\ne_1=In;\n\nOut2=-out_12*a1/a0-out_22*"
"a2/a0+In2*b0/a0+e_12*b1/a0+e_22*b2/a0;\n\nout_22=out_12;\nout_12=Out2;\ne_22="
"e_12;\ne_12=In2;\n"
                Show          off
