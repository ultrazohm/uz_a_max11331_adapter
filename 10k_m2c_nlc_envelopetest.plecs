"[2];\nSW4=SWtemp[3];\nSW5=SWtemp[4];\nSW6=SWtemp[5];\nt1 = rr;\nt2 = level;\n"
" /*\n  printf(\"Con orden:\\n\");\n \n  for(i=0;i<nc;i++)\n  \tprintf(\"%f \\"
"t\",Vxyvector[i].volt);\n  \t printf(\"\\n\");\nprintf(\"posicion:\\n\");\n\n"
"  for(i=0;i<nc;i++)\n  printf(\"%d \\t\",Vxyvector[i].pos);\n  \t printf(\"\\"
"n\");\n\nprintf(\"Vref:%f\\n\",Vref);\nif(S>0)printf(\"Signo corriente:Positi"
