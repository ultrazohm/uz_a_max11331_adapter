                    Value         "#include <float.h>\n#include\t<math.h>\n#in"
"clude <stdio.h>\n\n#define Vref       Input(0)\n#define Vxy1       Input(1)\n"
"#define Vxy2       Input(2)\n#define Vxy3       Input(3)\n#define Vxy4       "
"Input(4)\n#define Vxy5       Input(5)\n#define Vxy6       Input(6)\n#define S"
