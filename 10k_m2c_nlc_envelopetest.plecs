Plecs {
  Name          "10k_m2c_nlc_envelopetest"
  Version       "4.1"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  StopTime      "0.5"
  Timeout       ""
  Solver        "radau"
  MaxStep       "1e-6"
  InitStep      "-1"
  FixedStep     "ho/10"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "2"
  AssertionAction "1"
  InitializationCommands "Lcoup=-0.8;\nIoref=2.5;\nV_grid = 220 * sqrt(2);\t\t"
"% Grid peak voltage [V]\nf_grid = 50;\t\t\t\t\t% Grid frequency [Hz]\nw_grid "
"= f_grid * 2 * pi;\t% Grid frequency [rad/s]\nLac=2.0e-3;\nhv=200e-6;\nhs=hv;"
"\nfpwm=10000;\nf_load = 10000;\t\t\t\t\t% Load frequency [Hz]\nhsort=1/f_load"
";\n\nho=5e-6;\nhnlc=ho;\n\nN_delay=hnlc/2;\n\nh=0.1e-6;\nw_load = f_load * 2 "
"* pi;\t% Load frequency [rad/s]\nSigOsat=700;\nSigSsat=700;\nC = 900e-6;\t\t%"
" Cell capacitor capacitance [F]\nL = 0.4e-3;\nML = L*Lcoup;\n% Cluster induct"
"or inductance [H]\nR_Load = 470;%2e3;% Load [Ohm]\nR=1e-6;\nVc = 2700;%3100;"
"\t\t\t% cell capacitor voltage refence[V]\nVc_init = Vc/6*0.98;\t% Inital cel"
"l capacitor voltage [V]\nnc = 6;\nn=6;\nVd = V_grid;\nVo = R_Load*Ioref;\n\n%"
"w_BW = 0.01;%2*pi;\t% +/- 1 Hz PR Bandwidth\n\n% Input Current Controller par"
"ameters\nxi_s = 0.707107;\t\t\t% Damping coeficient\nwn_s = 800*2*pi;\t\t\t% "
"Bandwidth\nkp_s = 2*xi_s*L*wn_s;\t% Kp\nki_s = L*wn_s*wn_s;\t\t% Ki\n\n% Outp"
"ut Current Controller parameters\nxi_o = 0.707107;\t\t\t% Damping coeficient"
"\nwn_o = 1.1*f_load*2*pi;\t\t\t% Bandwidth\nkp_o = 2*xi_o*L*wn_o\t% Kp\nki_o "
"= L*wn_o*wn_o\t\t% Ki\n\n% Circulant Current Controller parameters\nxi_z = 0."
"707107;\t\t\t% Damping coeficient\nwn_z = 1.1*f_load*2*pi;\t\t\t% Bandwidth\n"
"kp_z = 2*xi_z*(L-ML)*wn_z;\t% Kp\nki_z = L*wn_z*wn_z;\t\t% Ki\numax_iz=Vo*100"
";\n% Average Balance Controller parameters\nxi_b1 = 0.707107;\t\t\t% Damping "
"coeficient\nwn_b1 = 10*2*pi;\t\t\t% Bandwidth\nkp_b1 = 2*xi_b1*wn_b1*4*C*Vc/("
"n*Vd)\t% Kp\nki_b1 = wn_b1*wn_b1*4*C*Vc/(n*Vd)\t\t% Ki\n%%Discrete\na1=-2*exp"
"(-xi_b1*wn_b1*hv)*cos(sqrt(1 -xi_b1^2)*wn_b1*hv);\na2=exp(-2*xi_b1*wn_b1*hv);"
"\nkk=4*C*Vc/n/Vd;\nkp_b1D=-(3*kk+kk*a1-kk*a2)/(2*hv)\nki_b1D=-kk/hv/hv*(1+a1+"
"a2)\n\n\n\n% Inner Balance Controller parameters\nxi_b2 = 0.707107;\t\t\t% Da"
"mping coeficient\nwn_b2 = 10*2*pi;\t\t\t% Bandwidth\nkp_b2 = 2*xi_b2*wn_b2*C*"
"Vc/(n*Vd);\t% Kp\nki_b2 = wn_b2*wn_b2*C*Vc/(n*Vd);\t% Ki\n\na1=-2*exp(-xi_b2*"
"wn_b2*hv)*cos(sqrt(1 -xi_b2^2)*wn_b2*hv);\na2=exp(-2*xi_b2*wn_b2*hv);\nkk=C*V"
"c/n/Vd;\nkp_b2D=-(3*kk+kk*a1-kk*a2)/(2*hv)\nki_b2D=-kk/hv/hv*(1+a1+a2)\n% Int"
"ra Balance Controller parameters\nxi_b3 = 0.707107;\t\t\t% Damping coeficient"
"\nwn_b3 = 10*2*pi;\t\t\t% Bandwidth\nki_b3 = wn_b3*wn_b3*4*C*Vc/(n*Vo);\t% Ki"
"\nkp_b3 = 2*xi_b3*wn_b3*4*C*Vc/(n*Vo);% Kp\n\na1=-2*exp(-xi_b3*wn_b3*hv)*cos("
"sqrt(1 -xi_b3^2)*wn_b3*hv);\na2=exp(-2*xi_b3*wn_b3*hv);\nkk=-4*C*Vc/n/Vo;\nkp"
"_b3D=-(3*kk+kk*a1-kk*a2)/(2*hv)\nki_b3D=-kk/hv/hv*(1+a1+a2)\n\n% Discretizaci"
"on Corrientes\n\n\t\t\na1=-2*exp(-xi_o*wn_o*ho)*cos(sqrt(1 -xi_o^2)*wn_o*ho);"
"\na2=exp(-2*xi_o*wn_o*ho);\n\nkp_oD=-(3*L+L*a1-L*a2)/(2*ho)\nki_oD=-L/ho/ho*("
"1+a1+a2)\n\n\t\t\na1=-2*exp(-xi_o*wn_s*hs)*cos(sqrt(1 -xi_s^2)*wn_s*hs);\na2="
"exp(-2*xi_s*wn_s*hs);\nk=L+2*Lac;\nkp_sD=-(3*k+k*a1-k*a2)/(2*hs)\nki_sD=-k/hs"
"/hs*(1+a1+a2)\n\n\n\na1=-2*exp(-xi_z*wn_z*ho)*cos(sqrt(1 -xi_z^2)*wn_z*ho);\n"
"a2=exp(-2*xi_z*wn_z*ho);\n\nkp_zDo=-(3*L+L*a1-L*a2)/(2*ho)\nki_zDo=-L/ho/ho*("
"1+a1+a2)\n\n%wn_z = 250*2*pi;\t\t\t% Bandwidth\n\na1=-2*exp(-xi_z*wn_z*hs)*co"
"s(sqrt(1 -xi_z^2)*wn_z*hs);\na2=exp(-2*xi_z*wn_z*hs);\n\nkp_zDs=-(3*L+L*a1-L*"
"a2)/(2*hs)\nki_zDs=-L/hs/hs*(1+a1+a2)\n\n%Discretizacion controladores Voltaj"
"e\n"
  InitialState  "1"
