              Parameter {
                Variable      "Declarations"
                Value         "#include <float.h>\n#include\t<math.h>\n#includ"
"e <stdio.h>\n\n#define In       Input(0)\n#define In2       Input(1)\n\n#defi"
"ne Out        Output(0)\n#define Out2        Output(1)\n\n\n\n#define fc     "
"    ParamRealData(0,0)  //sample period\n#define h         ParamRealData(1,0)"
"  //sample period\n\n\n\n#define max(x, y)\t(x) > (y) ? (x) : (y)\n#define mi"
"n(x, y)\t(x) < (y) ? (x) : (y)\n#define PI\t\t\t3.14159265358979323846\n\nflo"
"at out_1 =0.0;\nfloat e_1 = 0.0;\nfloat e_2=0.0;\nfloat out_2=0.0;\n\nfloat o"
"ut_12 =0.0;\nfloat e_12 = 0.0;\nfloat e_22=0.0;\nfloat out_22=0.0;\n\nfloat a"
"1;\nfloat a0;\nfloat a2;\nfloat b0;\nfloat b1;\nfloat b2;\nfloat Out_t=0.0;\n"
"float G0=1.0;"
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         "//Notch\na0=fc*fc*h*h+2.0*sqrt(2)*fc*h+4.0;\na1"
"=2.0*fc*fc*h*h-8.0;\na2=fc*h*fc*h-2.0*sqrt(2)*fc*h+4.0;\nb0=fc*fc*h*h+4.0;\nb"
"1=2*h*h*fc*fc-8.0;\nb2=b0;\n\n\n/*a1=2.0*cos(h*w);\na2=-1.0;\nb0=kp+ki*sin(h*"
"w)/(2.0*w);\nb1=0.0;\nb2=-ki*sin(h*w)/(2.0*w);*/"
                Show          off
              }
