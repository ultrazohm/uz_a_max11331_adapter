                  Parameter {
                    Variable      "StartFcn"
                    Value         "\nnc=NC;\nfor(i=0;i<2*nc+1;i++)\n\tfor(j=0;"
"j<nc;j++){\n\t if(i<=nc)\n            if(i<j+1)\n                tabla[i][j]="
"tabla[i][j]-1;            \n        if(i>nc)\n            tabla[i][j]=tabla[i"
"-nc][j]+1;\n     \n\t}\n\n"
                    Show          off
                  }
                  Parameter {
                    Variable      "OutputFcn"
                    Value         "Vxyvector[0].volt=Vxy1;\nVxyvector[0].pos=p"
"os1;\nVxyvector[1].volt=Vxy2;\nVxyvector[1].pos=pos2;\nVxyvector[2].volt=Vxy3"
";\nVxyvector[2].pos=pos3;\nVxyvector[3].volt=Vxy4;\nVxyvector[3].pos=pos4;\n"
"\nVxyvector[4].volt=Vxy5;\nVxyvector[4].pos=pos5;\n\nVxyvector[5].volt=Vxy6;"
"\nVxyvector[5].pos=pos6;\n\nvprom=0.0;\nfor(i=0;i<nc;i++)vprom=Vxyvector[i].v"
"olt+vprom;\n\nvprom=vprom/nc;\n//vprom=Vc;\nrr=round(Vref/vprom);\nif(rr>nc)r"
"r=nc;\nelse if(rr<-nc)rr=-nc;\n\t\n\nlevel=rr+nc;\n\nif(level>2*nc)\n\tlevel="
"2*nc;\nelse if(level<0)\n\tlevel = 0;\n\n\n\n//Orden de voltajes de menor a m"
"ayor\n\n//counter++;\nif(counter==0)\n{\n\tcounter=0;\n}\n\nif(S>0){\n  \tfor"
"(i=0;i<nc;i++)\n \t \tSWtemp[Vxyvector[i].pos]=tabla[level][i];\n  }\n  else{"
"\n  \tfor(i=0;i<nc;i++)\n \t SWtemp[Vxyvector[nc-i-1].pos]=tabla[level][i];\n"
"}\n\n\n  //Corriente positiva, carga condensadores\n/* if(S>0)\n  {\n  \tif(V"
