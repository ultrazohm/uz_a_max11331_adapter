"(0)\n#define SW2        Output(1)\n#define SW3        Output(2)\n#define SW4 "
"      Output(3)\n#define SW5        Output(4)\n#define SW6        Output(5)\n"
"#define t1        Output(6)\n#define t2        Output(7)\n#define carga\t\tOu"
