          Parameter {
            Variable      "Declarations"
            Value         "#include <float.h>\n#include\t<math.h>\n\n#define "
"\tX_aP\tInput(0)\n#define \tX_bP\tInput(1)\n#define \tX_cP\tInput(2)\n#define"
" \tX_aN\tInput(3)\n#define \tX_bN\tInput(4)\n#define \tX_cN\tInput(5)\n\n#def"
"ine \tX_alS\tOutput(0)\n#define \tX_beS\tOutput(1)\n#define \tX_0S\tOutput(2)"
"\n#define \tX_alD\tOutput(3)\n#define \tX_beD\tOutput(4)\n#define \tX_0D\tOut"
"put(5)"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "X_alS = 0.166667 * (2 *X_aP + 2 *X_aN - X_bP - X_bN"
" - X_cP - X_cN);\nX_beS = 0.288675 * (X_bP + X_bN - X_cP - X_cN);//Negative s"
"equence 0.288675 * (-X_bP - X_bN + X_cP + X_cN);\nX_0S  = 0.166667 * (X_aP + "
"X_aN + X_bP + X_bN + X_cP + X_cN);\nX_alD = 0.333333 * (-2 *X_aN + X_bN + X_c"
"N + 2 *X_aP - X_bP - X_cP);\nX_beD = 0.577350 * (X_bP - X_bN - X_cP + X_cN);/"
"/Negative sequence 0.577350 * (-X_bP + X_bN + X_cP - X_cN);\nX_0D  = 0.333333"
" * (X_aP - X_aN + X_bP - X_bN + X_cP - X_cN);\n\n//X_alD = (-0.666667 *X_aN  "
"+ 0.333333 *X_bN + 0.333333 *X_cN + 0.666667 *X_aP - 0.333333 *X_bP - 0.33333"
"3 *X_cP);"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
