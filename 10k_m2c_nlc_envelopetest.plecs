              }
              Parameter {
                Variable      "RuntimeCheck"
                Value         "2"
                Show          off
              }
              Parameter {
                Variable      "Declarations"
                Value         "#include <float.h>\n#include\t<math.h>\n#includ"
"e <stdio.h>\n\n#define error       Input(0)\n#define Filt       Input(1)\n\n#"
"define Out        Output(0)\n#define t1        Output(1)\n#define t2        O"
"utput(2)\n\n\n\n#define h         ParamRealData(0,0)  //sample period\n#defin"
"e w         ParamRealData(1,0)  //sample period\n#define kp         ParamReal"
"Data(2,0)  //sample period\n#define ki         ParamRealData(3,0)  //sample p"
"eriod\n#define umax         ParamRealData(4,0)  //sample period\n\n\n#define "
"max(x, y)\t(x) > (y) ? (x) : (y)\n#define min(x, y)\t(x) < (y) ? (x) : (y)\n#"
"define PI\t\t\t3.14159265358979323846\nfloat out_temp=0.0;\nfloat out_1 =0.0;"
"\nfloat e_1 = 0.0;\nfloat e_2=0.0;\nfloat out_2=0.0;\nfloat a1,a0f,a1f,a2f,b0"
"f,b1f,b2f;\nfloat a2;\nfloat b0;\nfloat b1;\nfloat b2;\nfloat fc=40.0*PI*2.0;"
"\nfloat G0=1.0;\nfloat in_sq,in_sq1,in_sq2;\nfloat in_filt,in_filt2,in_filt1;"
"\nfloat k=1.0;\nfloat Gmax=0.0;\nint c=0;\nint i=1;"
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         "a1=2.0*cos(h*w);\na2=-1.0;\nb0=kp+ki*sin(h*w)/("
"2*w);\nb1=-2.0*kp*cos(h*w);\nb2=kp-ki*sin(h*w)/(2*w);\n\na0f=fc*fc*h*h+2.0*sq"
"rt(2)*fc*h+4.0;\na1f=2.0*fc*fc*h*h-8.0;\na2f=fc*h*fc*h-2.0*sqrt(2)*fc*h+4.0;"
"\nb0f=fc*h*fc*h*G0;\nb1f=2.0*b0;\nb2f=b0;"
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "// Implementation of PR discrete with tustin wi"
"th prewarping\n\nin_sq=Out*Out;\n\nin_filt=-in_filt1*a1f/a0f-in_filt2*a2f/a0f"
"+in_sq*b0f/a0f+in_sq1*b1f/a0f+in_sq1*b2f/a0f;\n\nin_filt2=in_filt1;\nin_filt1"
"=in_filt;\nin_sq2=in_sq1;\nin_sq1=in_sq;\n//t1=in_filt;\nt2=in_sq;\n\n\n//Est"
"ado de saturacion en PR revisar signo luego\nout_temp=out_1*a1+out_2*a2+error"
"*b0+e_1*b1+e_2*b2;\nif(Filt > umax){\n\nOut=out_temp*umax/Filt;\n\nout_2=out_"
"1;\nout_1=Out;\ne_2=e_1;\ne_1=error;\n}\nelse{\nOut=out_temp;\nout_2=out_1;\n"
"out_1=Out;\ne_2=e_1;\ne_1=error;\n}\nif(Out>umax)\n\tt1=umax;\nelse if(Out<-u"
"max)\n\tt1=-umax;\nelse t1=Out;\n"
                Show          off
              }
              Parameter {
                Variable      "UpdateFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "DerivativeFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "TerminateFcn"
                Value         ""
                Show          off
              }
