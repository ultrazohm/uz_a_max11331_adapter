"e <stdio.h>\n\n#define In       Input(0)\n\n#define Out        Output(0)\n\n"
"\n\n#define fc         ParamRealData(0,0)  //sample period\n#define h        "
" ParamRealData(1,0)  //sample period\n\n\n\n#define max(x, y)\t(x) > (y) ? (x"
") : (y)\n#define min(x, y)\t(x) < (y) ? (x) : (y)\n#define PI\t\t\t3.14159265"
"358979323846\n\nfloat out_1 =0.0;\nfloat e_1 = 0.0;\nfloat e_2=0.0;\nfloat ou"
"t_2=0.0;\nfloat a1;\nfloat a0;\nfloat a2;\nfloat b0;\nfloat b1;\nfloat b2;\nf"
"loat Out_t=0.0;\nfloat G0=1.0;"
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         "//Notch\na0=(2.0+h*fc);\na1=-2.0+h*fc;\n\nb0=-1"
".0*(2.0-h*fc);\nb1=-1.0*(-2.0-h*fc);\n\n\n\n/*a1=2.0*cos(h*w);\na2=-1.0;\nb0="
"kp+ki*sin(h*w)/(2.0*w);\nb1=0.0;\nb2=-ki*sin(h*w)/(2.0*w);*/"
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "// Implementation of PR discrete with tustin wi"
"th prewarping\n\n\nOut=-out_1*a1/a0+In*b0/a0+e_1*b1/a0;\n\nout_1=Out;\ne_1=In"
";\n\n"
                Show          off
              }
              Parameter {
                Variable      "UpdateFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "DerivativeFcn"
                Value         ""
                Show          off
              }
