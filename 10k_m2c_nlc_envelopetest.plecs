                Value         "#include <float.h>\n#include\t<math.h>\n#includ"
"e <stdio.h>\n\n#define error       Input(0)\n\n#define Out        Output(0)\n"
"\n\n\n#define h         ParamRealData(0,0)  //sample period\n#define w       "
"  ParamRealData(1,0)  //sample period\n#define kp         ParamRealData(2,0) "
" //sample period\n#define ki         ParamRealData(3,0)  //sample period\n\n"
"\n#define max(x, y)\t(x) > (y) ? (x) : (y)\n#define min(x, y)\t(x) < (y) ? (x"
") : (y)\n#define PI\t\t\t3.14159265358979323846\n\nfloat out_1 =0.0;\nfloat e"
"_1 = 0.0;\nfloat e_2=0.0;\nfloat out_2=0.0;\nfloat a1;\nfloat a2;\nfloat b0;"
"\nfloat b1;\nfloat b2;"
                Show          off
              }
              Parameter {
                Variable      "StartFcn"
                Value         "a1=2.0*cos(h*w);\na2=-1.0;\nb0=kp+ki*sin(h*w)/("
"2*w);\nb1=-2.0*kp*cos(h*w);\nb2=kp-ki*sin(h*w)/(2*w);"
                Show          off
              }
              Parameter {
                Variable      "OutputFcn"
                Value         "// Implementation of PR discrete with tustin wi"
"th prewarping\n\nOut=out_1*a1+out_2*a2+error*b0+e_1*b1+e_2*b2;\nout_2=out_1;"
"\nout_1=Out;\ne_2=e_1;\ne_1=error;"
                Show          off
              }
              Parameter {
                Variable      "UpdateFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "DerivativeFcn"
                Value         ""
                Show          off
              }
              Parameter {
                Variable      "TerminateFcn"
                Value         ""
                Show          off
              }
            }
