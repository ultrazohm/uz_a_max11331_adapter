"clude <stdio.h>\n\n#define In       Input(0)\n#define In2       Input(1)\n\n#"
"define Out        Output(0)\n#define Out2        Output(1)\n\n\n\n#define fc "
"        ParamRealData(0,0)  //sample period\n#define h         ParamRealData("
"1,0)  //sample period\n\n\n\n#define max(x, y)\t(x) > (y) ? (x) : (y)\n#defin"
"e min(x, y)\t(x) < (y) ? (x) : (y)\n#define PI\t\t\t3.14159265358979323846\n"
"\n\nfloat out_1 =0.0;\nfloat e_1 = 0.0;\nfloat e_2=0.0;\nfloat out_2=0.0;\nfl"
"oat out_12 =0.0;\nfloat e_12 = 0.0;\nfloat e_22=0.0;\nfloat out_22=0.0;\nfloa"
"t a1;\nfloat a0;\nfloat a2;\nfloat b0;\nfloat b1;\nfloat b2;\nfloat Out_t=0.0"
";\nfloat G0=1.0;"
                    Show          off
                  }
                  Parameter {
                    Variable      "StartFcn"
                    Value         "//No se\na0=h*fc+2;\na1=h*fc-2;\na2=0.0;\nb"
"0=fc*h*G0;\nb1=b0;\n\n\n\n/*a1=2.0*cos(h*w);\na2=-1.0;\nb0=kp+ki*sin(h*w)/(2."
"0*w);\nb1=0.0;\nb2=-ki*sin(h*w)/(2.0*w);*/"
                    Show          off
                  }
                  Parameter {
                    Variable      "OutputFcn"
                    Value         "// Implementation of PR discrete with tusti"
"n with prewarping\n\n\nOut=-out_1*a1/a0+In*b0/a0+e_1*b1/a0;\n\nout_1=Out;\ne_"
"1=In;\n\nOut2=-out_12*a1/a0+In2*b0/a0+e_12*b1/a0;\n\nout_12=Out2;\ne_12=In2;"
"\n"
                    Show          off
                  }
                  Parameter {
                    Variable      "UpdateFcn"
                    Value         ""
                    Show          off
                  }
                  Parameter {
                    Variable      "DerivativeFcn"
                    Value         ""
                    Show          off
                  }
                  Parameter {
                    Variable      "TerminateFcn"
                    Value         ""
                    Show          off
                  }
