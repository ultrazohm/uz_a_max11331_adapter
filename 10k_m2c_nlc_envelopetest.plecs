"nc;j++){\n\t\t\tprintf(\"%d \",tabla[i][j]);\n\t\t\t}\n  \t printf(\"\\n\");"
"\n\n}\nprintf(\"Funcion de disparo \\n\");\n   for(i=0;i<nc;i++)\n  \tprintf("
